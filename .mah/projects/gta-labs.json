{
  "id": "gta-labs",
  "name": "GTA Labs",
  "description": "GTA Labs marketing site — blog, offers, case notes, landing pages. Humanize AI-written content, draft new posts, QA against voice guidelines.",
  "repo": "~/pro/web/apps/gta-labs",
  "createdAt": "2026-04-06T09:56:00Z",
  "config": {
    "priorities": { "quality": 1, "speed": 2, "cost": 3 },
    "defaultAgents": {
      "generator": { "type": "openclaw", "model": "sonnet" },
      "evaluator": { "type": "openclaw", "model": "sonnet" }
    },
    "qa": { "defaultTier": "targeted", "maxIterations": 3 },
    "skills": ["humanizer", "blog-writing"],
    "contentRoots": [
      "content/offers",
      "content/blog",
      "content/case-notes",
      "content/pages"
    ],
    "voiceGuide": "~/clawd/SOUL.md",
    "acceptanceCriteria": {
      "emDashCount": 0,
      "bannedVocabulary": [
        "leverage",
        "utilize",
        "streamline",
        "robust",
        "seamless",
        "furthermore",
        "moreover",
        "additionally",
        "delve",
        "testament",
        "pivotal",
        "underscore",
        "tapestry",
        "vibrant",
        "intricate",
        "landscape"
      ],
      "noRuleOfThree": true,
      "noTitleCaseHeadings": true,
      "noNegativeParallelism": true
    }
  }
}
